+            </div>
+          ) : (
+            <>
+              <p className="text-xs text-ink-500">O que você achou do sistema, ou o que poderia melhorar? Sua mensagem vai direto pra equipe.</p>
+              <textarea
+                value={texto}
+                onChange={(e) => setTexto(e.target.value)}
+                rows={4}
